# ─────────────────────────────────────────────────────────────
# KUMPA — variables de entorno (copiá este archivo a .env y completá)
# ─────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
BOT_MODE=polling            # polling (local) | webhook (producción)

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=           # CSV de user_id autorizados (vacío = todos)

# ── Supabase (memoria + settings) ───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM (opcional: también se puede setear en app_settings de Supabase)
#     groq | deepseek | openrouter | custom
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=               # override opcional (default según provider)
LLM_MODEL=
LLM_FAST_MODEL=
LLM_SMART_MODEL=

# Embeddings (memoria semántica; OpenAI text-embedding-3-small por defecto)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=         # default https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ── Fuentes de datos ────────────────────────────────────────
# Bitget (SOLO datos, nunca trading)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# On-chain / mercado
DUNE_API_KEY=
FLIPSIDE_API_KEY=
ARKHAM_API_KEY=
GLASSNODE_API_KEY=
ALCHEMY_API_KEY=

# Macro (FRED: tasas, CPI, VIX)
FRED_API_KEY=

# ── Redis (BullMQ — scheduler, opcional en MVP) ─────────────
UPSTASH_REDIS_URL=
